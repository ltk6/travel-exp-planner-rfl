# ==========================================
# Stage 1: Build dependencies
# ==========================================
FROM python:3.11-slim AS builder

WORKDIR /build

# Install compiler tools and system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install wheel
RUN pip install --no-cache-dir --upgrade pip wheel

# Copy only requirements to leverage Docker layer caching
COPY backend/services/n1_embedding/requirements.txt .

# Install dependencies into a separate wheels directory or virtual env
RUN pip wheel --no-cache-dir --wheel-dir=/build/wheels -r requirements.txt

# ==========================================
# Stage 2: Final minimal runtime image
# ==========================================
FROM python:3.11-slim AS runner

WORKDIR /app

# Copy wheels from builder and install them
COPY --from=builder /build/wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels /wheels/* && rm -rf /wheels

# Copy application source code
COPY backend/services/n1_embedding/ ./backend/services/n1_embedding/
COPY backend/shared/ ./backend/shared/
COPY config/ ./config/

# Configure model caching path for HuggingFace Hub downloads
ENV HF_HOME=/app/hf_cache
ENV PYTHONPATH=/app

# Create a non-root user and set permissions
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -m -s /bin/bash appuser && \
    mkdir -p /app/hf_cache && \
    chown -R appuser:appgroup /app

USER appuser

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/health')" || exit 1

CMD ["uvicorn", "backend.services.n1_embedding.app:app", "--host", "0.0.0.0", "--port", "8001"]
