# ==========================================
# Stage 1: Build dependencies
# ==========================================
FROM python:3.11-slim AS builder

WORKDIR /build

# Install compiler tools and system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install wheel
RUN pip install --no-cache-dir --upgrade pip wheel

# Copy requirements
COPY requirements.txt .
COPY backend/modules/n1_embedding/requirements.txt ./backend/modules/n1_embedding/requirements.txt
COPY backend/modules/n2_image_processing/requirements.txt ./backend/modules/n2_image_processing/requirements.txt
COPY backend/modules/n4_location_ranking/requirements.txt ./backend/modules/n4_location_ranking/requirements.txt
COPY backend/modules/n5_activity_generation/requirements.txt ./backend/modules/n5_activity_generation/requirements.txt
COPY backend/modules/n6_activity_ranking/requirements.txt ./backend/modules/n6_activity_ranking/requirements.txt
COPY backend/modules/n17_feedback_processing/requirements.txt ./backend/modules/n17_feedback_processing/requirements.txt
COPY backend/n3_database/requirements.txt ./backend/n3_database/requirements.txt
COPY backend/n18_orchestrator/requirements.txt ./backend/n18_orchestrator/requirements.txt
RUN pip wheel --no-cache-dir --wheel-dir=/build/wheels -r requirements.txt

# ==========================================
# Stage 2: Final minimal runtime image
# ==========================================
FROM python:3.11-slim AS runner

WORKDIR /app

# Copy wheels from builder and install them
COPY --from=builder /build/wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels /wheels/* && rm -rf /wheels

# Copy application source code
COPY backend/ ./backend/
COPY config/ ./config/

ENV PYTHONPATH=/app

# Create a non-root user and set permissions
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -m -s /bin/bash appuser && \
    chown -R appuser:appgroup /app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "backend.n18_orchestrator.app:app", "--host", "0.0.0.0", "--port", "8000"]
